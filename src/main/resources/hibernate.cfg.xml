<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="jakarta.persistence.jdbc.driver">org.postgresql.Driver</property>
        <property name="jakarta.persistence.jdbc.url">jdbc:postgresql://localhost:5432/queue_db</property>
        <property name="jakarta.persistence.jdbc.user">postgres</property>
        <property name="jakarta.persistence.jdbc.password">postgres</property>

        <!-- Настройки пула соединений -->
        <property name="hibernate.connection.pool_size">10</property>

        <!-- Показывать SQL в консоли (false для продакшена) -->
        <property name="show_sql">false</property>

        <!-- Управление схемой БД (update - автоматически создает/обновляет таблицы) -->
        <property name="hbm2ddl.auto">update</property>

        <!-- Контекст сессии -->
        <property name="current_session_context_class">thread</property>

        <!-- СПИСОК СУЩНОСТЕЙ (ENTITIES) -->
        <mapping class="by.frozzel.model.Student"/>
        <mapping class="by.frozzel.model.Subject"/>
        <mapping class="by.frozzel.model.QueueState"/>
        <mapping class="by.frozzel.model.SwapRequest"/>
        <mapping class="by.frozzel.model.TemporarySwap"/>
        <mapping class="by.frozzel.model.SkippedStudent"/>

    </session-factory>
</hibernate-configuration>